# Copie para .env. O .env está no .gitignore: nada daqui com valor vai para o repositório.

# Endereço público do site, sem barra no fim (aparece nos links curtos)
APP_URL=http://localhost:8080

# Sal dos hashes de visitas e de tentativas de login. Opcional: se ficar vazio,
# é sorteado na primeira execução e guardado em dados/sal.txt (fora do git).
# Para definir o seu:  php -r "echo bin2hex(random_bytes(32));"
APP_SAL=

# 1 = o site roda atrás de proxy reverso (Traefik, Nginx, Cloudflare, painel de
# contêiner) e deve ler o IP e o HTTPS de X-Forwarded-For / X-Forwarded-Proto.
# Deixe vazio sem proxy: aí esses cabeçalhos podem ser forjados por qualquer um.
CONFIAR_PROXY=

NOME_SITE=Biblioteca Comunitária Ipê Amarelo
FUSO=America/Sao_Paulo

# Opcional: caminho do banco SQLite (padrão: dados/site.sqlite, fora da pasta pública)
BANCO_ARQUIVO=
